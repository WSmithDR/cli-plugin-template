#!/usr/bin/env python3
"""CLI unificado del meta-plugin (cli-plugin-template).

Punto de entrada para TODAS las operaciones del store de evolución de plugins.
Las skills y hooks lo invocan:
    python3 "$CLAUDE_PLUGIN_ROOT/bin/cpt" registry register <name> <path>
    python3 "$CLAUDE_PLUGIN_ROOT/bin/cpt" feedback save <plugin> <slug> -

Grupos:
    registry  register | list | resolve   (allowlist de plugins propios)
    feedback  save | list                 (captura de fricción por plugin)
    learning  save | list | show | delete (conocimiento vigente del taller)
"""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

import gateway  # noqa: E402


def _read_content(arg: str) -> str:
    """'-' lee stdin (heredoc); cualquier otra cosa es contenido literal."""
    return sys.stdin.read() if arg == "-" else arg


def _c(code: str, s: str) -> str:
    """Color ANSI solo en tty real y sin NO_COLOR — en pipes/tests sale plano."""
    import os
    if sys.stdout.isatty() and not os.environ.get("NO_COLOR"):
        return f"\033[{code}m{s}\033[0m"
    return s

def _warn(s: str) -> str:
    return _c("33", s)

def _ok(s: str) -> str:
    return _c("32", s)

def _dim(s: str) -> str:
    return _c("2", s)

def _bold(s: str) -> str:
    return _c("1", s)


def main() -> int:
    parser = argparse.ArgumentParser(prog="cpt")
    sub = parser.add_subparsers(dest="group", required=True)

    # registry ────────────────────────────────────────────────
    reg = sub.add_parser("registry", help="allowlist de plugins propios")
    reg_sub = reg.add_subparsers(dest="op", required=True)

    r_register = reg_sub.add_parser("register", help="dar de alta / actualizar un plugin")
    r_register.add_argument("name")
    r_register.add_argument("local_path")
    r_register.add_argument("--remote", default="")
    r_register.add_argument("--manifest", default=".claude-plugin/plugin.json")
    r_register.add_argument("--namespace", action="append", dest="namespaces",
                            help="skill namespace del plugin (repetible); default = name")

    reg_sub.add_parser("list", help="listar plugins registrados")

    r_resolve = reg_sub.add_parser("resolve", help="skill namespace → name del plugin")
    r_resolve.add_argument("skill_namespace")

    # feedback ─────────────────────────────────────────────────
    fb = sub.add_parser("feedback", help="captura de fricción por plugin")
    fb_sub = fb.add_subparsers(dest="op", required=True)

    f_save = fb_sub.add_parser("save", help="guardar un feedback")
    f_save.add_argument("plugin")
    f_save.add_argument("slug")
    f_save.add_argument("content", nargs="?", default="-",
                        help="'-' (default) lee stdin; o contenido literal")

    f_list = fb_sub.add_parser("list", help="listar feedbacks")
    f_list.add_argument("--plugin", default=None)
    f_list.add_argument("--pending", action="store_true")
    f_list.add_argument("--state", default=None,
                        choices=("pending", "applied", "discarded", "deferred"))

    f_show = fb_sub.add_parser("show", help="imprimir el contenido de un feedback")
    f_show.add_argument("plugin")
    f_show.add_argument("slug")

    f_apply = fb_sub.add_parser("apply", help="marcar un feedback como aplicado")
    f_apply.add_argument("plugin")
    f_apply.add_argument("slug")
    f_apply.add_argument("--at", default=None, help="fecha last_updated (default: hoy UTC)")

    f_disc = fb_sub.add_parser("discard", help="marcar un feedback como descartado")
    f_disc.add_argument("plugin")
    f_disc.add_argument("slug")
    f_disc.add_argument("--at", default=None, help="fecha last_updated (default: hoy UTC)")

    f_defer = fb_sub.add_parser("defer", help="posponer un feedback para revisión futura")
    f_defer.add_argument("plugin")
    f_defer.add_argument("slug")
    f_defer.add_argument("--at", default=None, help="fecha last_updated (default: hoy UTC)")

    f_audit = fb_sub.add_parser("audit",
                                help="pendientes con evidencia de ya-aplicados en su repo")
    f_audit.add_argument("plugin", nargs="?", default=None)
    f_audit.add_argument("--json", action="store_true")

    f_watch = fb_sub.add_parser("watch",
                                help="instala/quita el aviso post-commit en el repo")
    f_watch.add_argument("plugin")
    f_watch.add_argument("--remove", action="store_true")

    f_learn = fb_sub.add_parser("learn",
                                help="aprender una frase de fricción para el Stop hook")
    f_learn.add_argument("plugin")
    f_learn.add_argument("phrase")

    # proposal ─────────────────────────────────────────────────
    pr = sub.add_parser("proposal", help="gate de aprobación de patches")
    pr_sub = pr.add_subparsers(dest="op", required=True)

    p_save = pr_sub.add_parser("save", help="guardar/sobrescribir una propuesta")
    p_save.add_argument("plugin")
    p_save.add_argument("slug")
    p_save.add_argument("content", nargs="?", default="-")

    p_show = pr_sub.add_parser("show", help="imprimir una propuesta")
    p_show.add_argument("plugin")
    p_show.add_argument("slug")

    p_list = pr_sub.add_parser("list", help="listar propuestas")
    p_list.add_argument("--plugin", default=None)
    p_list.add_argument("--status", default=None)

    p_status = pr_sub.add_parser("set-status", help="cambiar el status de una propuesta")
    p_status.add_argument("plugin")
    p_status.add_argument("slug")
    p_status.add_argument("status")

    # status (dashboard) ───────────────────────────────────────
    # learning ────────────────────────────────────────────────
    lr = sub.add_parser("learning", help="aprendizajes vivos del taller y por plugin")
    lr_sub = lr.add_subparsers(dest="op", required=True)

    l_save = lr_sub.add_parser("save", help="guardar/corregir un aprendizaje (upsert por slug)")
    l_save.add_argument("slug")
    l_save.add_argument("content", help="'-' lee stdin")
    l_save.add_argument("--plugin", default=None,
                        help="scope: el plugin al que aplica. Sin esto va al taller (global).")
    l_save.add_argument("--category", default=None, choices=gateway.LEARNING_CATEGORIES)

    l_list = lr_sub.add_parser("list", help="aprendizajes vigentes (los del plugin + los del taller)")
    l_list.add_argument("--plugin", default=None)
    l_list.add_argument("--category", default=None, choices=gateway.LEARNING_CATEGORIES)
    l_list.add_argument("--full", action="store_true", help="imprimir el contenido, no solo los slugs")

    l_show = lr_sub.add_parser("show", help="imprimir un aprendizaje")
    l_show.add_argument("scope", help="nombre del plugin, o _global")
    l_show.add_argument("slug")

    l_del = lr_sub.add_parser("delete", help="borrar un aprendizaje que dejó de valer")
    l_del.add_argument("scope")
    l_del.add_argument("slug")

    st = sub.add_parser("status", help="dashboard de evolución de los plugins")
    st.add_argument("--plugin", default=None)
    st.add_argument("--json", action="store_true")

    ns = parser.parse_args()

    if ns.group == "registry":
        if ns.op == "register":
            entry = gateway.registry_register(
                ns.name, ns.local_path, remote=ns.remote,
                manifest=ns.manifest, skill_namespaces=ns.namespaces)
            print(json.dumps(entry, ensure_ascii=False))
        elif ns.op == "list":
            print(json.dumps(gateway.registry_list(), ensure_ascii=False, indent=2))
        elif ns.op == "resolve":
            out = gateway.registry_resolve_namespace(ns.skill_namespace)
            print(out if out is not None else "", end="")
            if out is None:
                return 1

    elif ns.group == "feedback":
        if ns.op == "save":
            print(gateway.feedback_save(ns.plugin, ns.slug, _read_content(ns.content)))
        elif ns.op == "list":
            print("\n".join(gateway.feedback_list(plugin=ns.plugin, pending_only=ns.pending,
                                                  state=ns.state)))
        elif ns.op == "show":
            print(gateway.feedback_load(ns.plugin, ns.slug), end="")
        elif ns.op == "apply":
            print(gateway.feedback_set_status(ns.plugin, ns.slug, "applied", at=ns.at))
        elif ns.op == "discard":
            print(gateway.feedback_set_status(ns.plugin, ns.slug, "discarded", at=ns.at))
        elif ns.op == "defer":
            print(gateway.feedback_set_status(ns.plugin, ns.slug, "deferred", at=ns.at))
        elif ns.op == "audit":
            names = [ns.plugin] if ns.plugin else \
                    [e["name"] for e in gateway.registry_list()]
            found = [{"plugin": n, **f}
                     for n in names for f in gateway.feedback_audit(n)]
            if ns.json:
                print(json.dumps(found, ensure_ascii=False))
            elif found:
                print(_warn(f"DRIFT: {len(found)} feedback(s) pendientes con "
                            f"evidencia de aplicación:"))
                for f in found:
                    print(f"  {f['plugin']}/{f['slug']} {_dim('| commits: ' + ', '.join(f['commits']))}")
                print(_dim("Revisá cada uno y cerrá con: cpt feedback apply <plugin> <slug>"))
        elif ns.op == "watch":
            msg = gateway.feedback_watch_install(ns.plugin, remove=ns.remove)
            if msg:
                print(_ok(msg) if msg.startswith("instalado") else msg)
        elif ns.op == "learn":
            print(json.dumps(gateway.feedback_learn(ns.plugin, ns.phrase),
                             ensure_ascii=False))

    elif ns.group == "proposal":
        if ns.op == "save":
            print(gateway.proposal_save(ns.plugin, ns.slug, _read_content(ns.content)))
        elif ns.op == "show":
            print(gateway.proposal_load(ns.plugin, ns.slug), end="")
        elif ns.op == "list":
            print("\n".join(gateway.proposal_list(plugin=ns.plugin, status=ns.status)))
        elif ns.op == "set-status":
            print(gateway.proposal_set_status(ns.plugin, ns.slug, ns.status))

    elif ns.group == "learning":
        if ns.op == "save":
            print(gateway.learning_save(ns.slug, _read_content(ns.content),
                                        plugin=ns.plugin, category=ns.category))
        elif ns.op == "list":
            refs = gateway.learning_list(plugin=ns.plugin, category=ns.category)
            if not ns.full:
                print("\n".join(refs))
            else:
                for ref in refs:
                    scope, slug = ref.split("/", 1)
                    print(f"# {ref}\n{gateway.learning_load(scope, slug)}")
        elif ns.op == "show":
            print(gateway.learning_load(ns.scope, ns.slug), end="")
        elif ns.op == "delete":
            print(gateway.learning_delete(ns.scope, ns.slug))

    elif ns.group == "status":
        summary = gateway.growth_summary(plugin=ns.plugin)
        if ns.json:
            print(json.dumps(summary, ensure_ascii=False, indent=2))
        else:
            _print_status(summary)

    return 0


def _print_status(summary: dict) -> None:
    rows = summary["plugins"]
    t = summary["totals"]
    if not rows:
        print("EVOLUCIÓN DE PLUGINS — sin plugins registrados ni datos en el store.")
        print("Registrá uno con la skill plugin-register.")
        return
    print(_bold(f"EVOLUCIÓN DE PLUGINS  ({t['plugins']} plugins · "
          f"{t['feedbacks_pending']} feedbacks pendientes · "
          f"{t['proposals_pending']} propuestas pending)"))
    print("─" * 72)
    width = max(len(r["name"]) for r in rows)
    for r in rows:
        fb, pr = r["feedbacks"], r["proposals"]
        pend = _warn(str(fb['pending'])) if fb['pending'] else _ok("0")
        flag = "" if r["registered"] else " (no registrado)"
        print(f"{_bold(r['name']):<{width + 8}}  ▸ feedbacks: {pend} pend / {fb['applied']} aplicados"
              f" / {fb['discarded']} descartados"
              f"   propuestas: {_warn(str(pr['pending'])) if pr['pending'] else '0'} pending · "
              f"{pr['approved']} approved · "
              f"{pr['discarded']} discarded{flag}")
        if r["local_path"]:
            print(f"{'':<{width}}    {_dim(r['local_path'])}")


if __name__ == "__main__":
    raise SystemExit(main())
